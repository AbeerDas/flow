# Copy to .env.local and fill in whichever route you are using.
# .env.local is ignored by git.

# Which route to use. One of vercel, openrouter, typesafe. Defaults to vercel.
FLOW_PROFILE=vercel

# Vercel AI Gateway. Free until 25 September 2026, needs a card on file first.
AI_GATEWAY_API_KEY=

# OpenRouter. Prepaid credits, stops dead at zero, no standing charge.
OPENROUTER_API_KEY=

# TypeSafe directly. Waitlisted.
TYPESAFE_API_KEY=
